# Copy to .env (never commit .env). All server settings use the QUANTAGENT_ prefix.
QUANTAGENT_DB_URL=sqlite:///data/db/quantagent.db
# Used only when no 91-day T-bill series is loaded; every response labels it as an assumption.
QUANTAGENT_RISK_FREE_ANNUAL=0.065
QUANTAGENT_RISK_FREE_SOURCE=Config default (assumption): approx. RBI 91-day T-bill yield, FY2024-25
QUANTAGENT_LOG_LEVEL=INFO
QUANTAGENT_MAX_RESULTS=50
QUANTAGENT_MAX_FUNDS=10
QUANTAGENT_MAX_RANGE_YEARS=25
QUANTAGENT_TIMEOUT_S=10
QUANTAGENT_MODEL_DIR=models/registry
QUANTAGENT_STAGING_DIR=data/staging
QUANTAGENT_EXTERNAL_DIR=data/external
QUANTAGENT_REFERENCE_DIR=data/reference
QUANTAGENT_REPORTS_DIR=reports

# Agent only (quantagent ask / quantagent eval --agent). Read from the environment by the
# Anthropic SDK; never written to logs, run files or reports.
ANTHROPIC_API_KEY=
QUANTAGENT_AGENT_MODEL=claude-sonnet-5-5
